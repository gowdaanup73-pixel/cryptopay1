# ─────────────────────────────────────────────────────────────
# CryptoPay Backend — Environment Variables
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=4000
JWT_SECRET=change-me-to-a-random-64-char-string

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://cryptopay:cryptopay_secret@localhost:5432/cryptopay

# ── Blockchain (Sepolia) ────────────────────────────────────
SEPOLIA_RPC_URL=https://rpc.sepolia.org
# Private key of a wallet funded with Sepolia ETH.
# This wallet MUST be an authorized reviewer on the smart contract.
SERVER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed CryptoPaymentGateway contract address on Sepolia
CONTRACT_ADDRESS=0x435240f7b61063883c0150Df7f179f7CAE78Ab0c

# ── Pinata (IPFS) ───────────────────────────────────────────
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt

# ── PAN Verification Aggregator ─────────────────────────────
# Replace with your aggregator's details (Perfios / AuthBridge / Meon / Eko)
PAN_AGGREGATOR_BASE_URL=https://api.example-aggregator.com
PAN_AGGREGATOR_ENDPOINT=/v1/pan/verify
PAN_AGGREGATOR_API_KEY=your_aggregator_api_key

# ── Frontend URL (CORS) ─────────────────────────────────────
FRONTEND_URL=http://localhost:3000
