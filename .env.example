# Public frontend settings for local development.
# Copy to .env.local. Next.js exposes NEXT_PUBLIC_* values in the browser;
# never place private keys, API secrets, service-role keys, or passwords here.
NEXT_PUBLIC_APP_NAME=CoinCrop
NEXT_PUBLIC_NETWORK=localhost
NEXT_PUBLIC_CHAIN_ID=1337
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Optional: set these if local contract addresses differ from the defaults.
# NEXT_PUBLIC_PAYMENT_GATEWAY_ADDRESS=
# NEXT_PUBLIC_USDT_ADDRESS=
# NEXT_PUBLIC_USDC_ADDRESS=
# NEXT_PUBLIC_CROP_LOAN_ADDRESS=
